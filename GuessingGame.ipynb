   "source": [
    "# Guessing game tehtävä\n",
    "\n",
    "nimi = \"Jonathan\"\n",
    "nimi = input(\"Arvaa nimi: \")\n",
    "\n",
    "if nimi == \"Jonathan\":\n",
    "    print(\"Onnittelut!\")\n",
    "\n",
    "while nimi != \"Jonathan\":\n",
    "    print(\"Väärä vastaus! Yritä uudelleen: \")\n",
    "    nimi = input(\"Arvaa nimi: \")\n",
    "\n",
    "print(\"Oikein arvattu! Onnittelut!\")"
   ]
  }
 ],
